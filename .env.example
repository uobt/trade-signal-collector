# Ключи НЕ коммитить. Скопировать в .env и заполнить после регистрации.

# UN Comtrade (контур A, статистика ООН):
# 1. https://comtradeplus.un.org/ -> Sign Up (e-mail владельца)
# 2. После входа: Account/API Key -> скопировать ключ
COMTRADE_API_KEY=

# US Census International Trade API (контур A, пилот):
# 1. https://api.census.gov/data/key_signup.html
# 2. Ключ приходит на e-mail; активация по ссылке в письме
CENSUS_API_KEY=

# Контур B (уровень компаний) — пока без ключей; ImportYeti BLOCKED (403)
